# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=tempovis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tempovis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full DSN (alternative to component vars above — takes precedence if set)
DATABASE_URL=postgresql+asyncpg://tempovis:changeme@localhost:5432/tempovis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development        # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120

# ── Renderer ──────────────────────────────────────────────────────────────────
PLOT_DPI=150
PLOT_WIDTH_IN=12
PLOT_HEIGHT_IN=5

# ── DRY_RUN / testing ─────────────────────────────────────────────────────────
# Set DRY_RUN=true to skip all OpenAI calls and return a hardcoded mock result.
# The full pipeline (rendering, agent loop, DB storage, dashboard) still runs.
DRY_RUN=false
# Hard cap on real OpenAI API calls per UTC day (enforced via Redis).
# When exceeded the API returns a friendly error instead of a 429/quota failure.
MAX_CALLS_PER_DAY=20
